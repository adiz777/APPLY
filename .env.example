# APPLY — Environment Configuration Example
# Copy this file to .env and configure values as needed. Never commit .env!

# Backend Server & Database
APPLY_ENV=development
APPLY_SECRET_KEY=change-this-in-production-to-a-32-byte-hex-secret
APPLY_ENCRYPTION_KEY=change-this-32-byte-base64-fernet-key-in-prod
DATABASE_URL=sqlite:///./data/apply.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://apply_user:password@localhost:5432/apply_db

# Authentication (Initial Admin / Candidate Account)
APPLY_DEFAULT_ADMIN_EMAIL=candidate@apply.local
APPLY_DEFAULT_ADMIN_PASSWORD=ChangeMeImmediately!2026

# AI Provider Settings (Optional — Configurable via UI Settings as well)
AI_DEFAULT_PROVIDER=ollama
AI_FALLBACK_ENABLED=true

# Google Gemini API (Free tier supported)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OpenAI / OpenAI-Compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local Ollama (Zero paid subscription required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Job Discovery Providers (Optional API keys for extended aggregators)
ADZUNA_APP_ID=
ADZUNA_API_KEY=
REED_API_KEY=
JOOBLE_API_KEY=

# Playwright Browser Automation
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
APPLY_REQUIRE_HUMAN_APPROVAL=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
